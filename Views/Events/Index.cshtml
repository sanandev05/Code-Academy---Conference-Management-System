@model CreateNewEventVM

@{
    ViewData["Title"] = "Tədbirlər";
}
<style>
    /* Table Styling */
    .table-event-types th, .table-event-types td {
        vertical-align: middle;
    }

    .table-event-types thead th {
        background-color: #f8f9fa;
        border-bottom: 2px solid #dee2e6;
    }

    .action-buttons .btn {
        margin-right: 5px;
    }
    
</style>
<div class="container mt-4">
    <h2 class="mb-3">Tədbirlər</h2>

    <!-- Create Button -->
    <button class="btn btn-primary mb-3" data-bs-toggle="modal" data-bs-target="#eventModal">+ Tədbir əlavə et</button>

    <!-- Event Table -->
    @if (Model.EventVMs != null && Model.EventVMs.Any() &&
    Model.EventTypes != null && Model.Locations != null && Model.Organizers != null)
    {
        <table class="table table-hover table-event-types">
            <thead>
                <tr>
                    <th>Başlıq</th>
                    <th>Təsvir</th>
                    <th>Tarix</th>
                    <th>Vaxt</th>
                    <th>Tip</th>
                    <th>Məkan</th>
                    <th>Təşkilatçı</th>
                    <th>Əməliyyatlar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ev in Model.EventVMs)
                {
                    <tr>
                        <td>@ev.Title</td>
                        <td>@ev.Description</td>
                        <td>@ev.StartDate.ToShortDateString() - @ev.EndDate.ToShortDateString()</td>
                        <td>@ev.StartTime.ToString("hh\\:mm") - @ev.EndTime.ToString("hh\\:mm")</td>
                        <td>@Model.EventTypes.FirstOrDefault(e => e.ID == ev.EventTypeId)?.Name</td>
                        <td>@Model.Locations.FirstOrDefault(l => l.ID == ev.LocationId)?.Name</td>
                        <td>@Model.Organizers.FirstOrDefault(o => o.ID == ev.OrganizerId)?.FullName</td>
                        <td>
                            <!-- Edit button triggers modal and fills form -->
                            <button type="button" class="btn btn-sm btn-warning"
                                    data-bs-toggle="modal" data-bs-target="#eventModal"
                                    data-id="@ev.ID"
                                    data-title="@ev.Title"
                                    data-description="@ev.Description"
                                    data-startdate="@ev.StartDate.ToString("yyyy-MM-dd")"
                                    data-enddate="@ev.EndDate.ToString("yyyy-MM-dd")"
                                    data-starttime="@ev.StartTime.ToString(@"hh\:mm")"
                                    data-endtime="@ev.EndTime.ToString(@"hh\:mm")"
                                    data-eventtypeid="@ev.EventTypeId"
                                    data-locationid="@ev.LocationId"
                                    data-organizerid="@ev.OrganizerId"
                                    onclick="populateEditModal(this)">
                                Düzəlt
                            </button>

                            <!-- Delete button triggers delete confirm modal -->
                            <button type="button" class="btn btn-sm btn-danger"
                                    data-bs-toggle="modal" data-bs-target="#deleteModal"
                                    data-id="@ev.ID"
                                    data-title="@ev.Title"
                                    onclick="populateDeleteModal(this)">
                                Sil
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">Tədbir yoxdur.</div>
    }

    <!-- Create/Edit Modal (your existing modal with a hidden ID field and updated form action) -->
    <div class="modal fade" id="eventModal" tabindex="-1" aria-labelledby="eventModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="eventModalLabel">Yeni Tədbir</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="eventForm" method="post" asp-action="Create">
                        <input type="hidden" id="EventId" name="EventVM.ID" />
                        <div class="row mb-2">
                            <div class="col-md-6">
                                <label>Başlıq</label>
                                <input class="form-control" name="EventVM.Title" id="EventTitle" />
                            </div>
                            <div class="col-md-6">
                                <label>Təsvir</label>
                                <input class="form-control" name="EventVM.Description" id="EventDescription" />
                            </div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-md-6">
                                <label>Başlanğıc tarixi</label>
                                <input type="date" class="form-control" name="EventVM.StartDate" id="EventStartDate" />
                            </div>
                            <div class="col-md-6">
                                <label>Bitmə tarixi</label>
                                <input type="date" class="form-control" name="EventVM.EndDate" id="EventEndDate" />
                            </div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-md-6">
                                <label>Başlanğıc vaxtı</label>
                                <input type="time" class="form-control" name="EventVM.StartTime" id="EventStartTime" />
                            </div>
                            <div class="col-md-6">
                                <label>Bitmə vaxtı</label>
                                <input type="time" class="form-control" name="EventVM.EndTime" id="EventEndTime" />
                            </div>
                        </div>
                        <div class="mb-2">
                            <label>Tip</label>
                            <select class="form-select" name="EventVM.EventTypeId" id="EventTypeId">
                                <option value="">-- Seçin --</option>
                                @foreach (var type in Model.EventTypes!)
                                {
                                    <option value="@type.ID">@type.Name</option>
                                }
                            </select>
                        </div>
                        <div class="mb-2">
                            <label>Məkan</label>
                            <select class="form-select" name="EventVM.LocationId" id="LocationId">
                                <option value="">-- Seçin --</option>
                                @foreach (var loc in Model.Locations!)
                                {
                                    <option value="@loc.ID">@loc.Name</option>
                                }
                            </select>
                        </div>
                        <div class="mb-2">
                            <label>Təşkilatçı</label>
                            <select class="form-select" name="EventVM.OrganizerId" id="OrganizerId">
                                <option value="">-- Seçin --</option>
                                @foreach (var org in Model.Organizers!)
                                {
                                    <option value="@org.ID">@org.FullName</option>
                                }
                            </select>
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-success" id="saveBtn">Yadda saxla</button>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Bağla</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal (matches your style) -->
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-action="Delete">
                    <div class="modal-header">
                        <h5 class="modal-title" id="deleteModalLabel">Təsdiq</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="id" id="deleteEventId" />
                        <p>Seçilmiş "<strong id="deleteEventTitle"></strong>" tədbirini silmək istədiyinizə əminsiniz?</p>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-danger">Bəli, Sil</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Xeyr</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="~/assets/libs/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>

<script>
    // Fill edit modal inputs from button data attributes
    function populateEditModal(button) {
        document.getElementById('eventModalLabel').textContent = 'Tədbiri Düzəlt';
        document.getElementById('EventId').value = button.getAttribute('data-id');
        document.getElementById('EventTitle').value = button.getAttribute('data-title');
        document.getElementById('EventDescription').value = button.getAttribute('data-description');
        document.getElementById('EventStartDate').value = button.getAttribute('data-startdate');
        document.getElementById('EventEndDate').value = button.getAttribute('data-enddate');
        document.getElementById('EventStartTime').value = button.getAttribute('data-starttime');
        document.getElementById('EventEndTime').value = button.getAttribute('data-endtime');
        document.getElementById('EventTypeId').value = button.getAttribute('data-eventtypeid');
        document.getElementById('LocationId').value = button.getAttribute('data-locationid');
        document.getElementById('OrganizerId').value = button.getAttribute('data-organizerid');

        // Change form action to Edit
        document.getElementById('eventForm').setAttribute('action', '/Events/Edit');
    }

    // Reset modal for creating new event
    var eventModal = document.getElementById('eventModal');
    eventModal.addEventListener('show.bs.modal', function (event) {
        var button = event.relatedTarget;
        if (!button.getAttribute('data-id')) { // if create button (no data-id)
            document.getElementById('eventModalLabel').textContent = 'Yeni Tədbir';
            document.getElementById('EventId').value = '';
            document.getElementById('EventTitle').value = '';
            document.getElementById('EventDescription').value = '';
            document.getElementById('EventStartDate').value = '';
            document.getElementById('EventEndDate').value = '';
            document.getElementById('EventStartTime').value = '';
            document.getElementById('EventEndTime').value = '';
            document.getElementById('EventTypeId').value = '';
            document.getElementById('LocationId').value = '';
            document.getElementById('OrganizerId').value = '';

            // Change form action to Create
            document.getElementById('eventForm').setAttribute('action', '/Events/Create');
        }
    });

    // Populate delete modal
    function populateDeleteModal(button) {
        document.getElementById('deleteEventId').value = button.getAttribute('data-id');
        document.getElementById('deleteEventTitle').textContent = button.getAttribute('data-title');
    }
</script>
