@model IEnumerable<InvitationVM>
@using Code_Academy___Conference_Management_System.Models

@{
    ViewData["Title"] = "Dəvətlərim";
    // Group invitations by status for easy access in the tabs
    var pendingInvitations = Model.Where(i => i.InvitationStatus == InvitationVM.Status.Pending);
    var acceptedInvitations = Model.Where(i => i.InvitationStatus == InvitationVM.Status.Accepted);
    var declinedInvitations = Model.Where(i => i.InvitationStatus == InvitationVM.Status.Declined);
}

<div class="container-fluid">
    <div class="card shadow-none">
        <div class="card-body">
            <h1 class="card-title fw-semibold mb-4">@ViewData["Title"]</h1>

            <!-- Tab Navigation -->
            <ul class="nav nav-tabs" id="invitationTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="pending-tab" data-bs-toggle="tab" data-bs-target="#pending-tab-pane" type="button" role="tab" aria-controls="pending-tab-pane" aria-selected="true">
                        Gözləyən <span class="badge bg-warning ms-1">@pendingInvitations.Count()</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="accepted-tab" data-bs-toggle="tab" data-bs-target="#accepted-tab-pane" type="button" role="tab" aria-controls="accepted-tab-pane" aria-selected="false">
                        Qəbul Edilmiş <span class="badge bg-success ms-1">@acceptedInvitations.Count()</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="declined-tab" data-bs-toggle="tab" data-bs-target="#declined-tab-pane" type="button" role="tab" aria-controls="declined-tab-pane" aria-selected="false">
                        Rədd Edilmiş <span class="badge bg-danger ms-1">@declinedInvitations.Count()</span>
                    </button>
                </li>
            </ul>

            <!-- Tab Content -->
            <div class="tab-content" id="invitationTabsContent">

                <!-- Pending Invitations Pane -->
                <div class="tab-pane fade show active p-3" id="pending-tab-pane" role="tabpanel" aria-labelledby="pending-tab" tabindex="0">
                    @if (pendingInvitations.Any())
                    {
                        foreach (var invitation in pendingInvitations)
                        {
                            <div class="card mb-3 shadow-sm">
                                <div class="card-body">
                                    <div class="row align-items-center">
                                        <div class="col-md-7">
                                            <p class="card-text text-muted mb-2">
                                                <i class="ti ti-calendar-event me-1"></i> @invitation.Event.StartDate.ToString("dd MMMM yyyy, HH:mm")
                                            </p>
                                            <p class="card-text text-muted mb-0">
                                                <i class="ti ti-map-pin me-1"></i> @invitation.Event.Location?.Name
                                            </p>
                                        </div>
                                        <div class="col-md-5 text-md-end mt-3 mt-md-0">
                                            <form asp-action="Respond" method="post" class="d-flex gap-2 justify-content-md-end">
                                                <input type="hidden" name="id" value="@invitation.ID" />
                                                <button type="submit" name="decision" value="accept" class="btn btn-success">
                                                    <i class="ti ti-check me-1"></i> Qəbul et
                                                </button>
                                                <button type="submit" name="decision" value="reject" class="btn btn-outline-danger">
                                                    <i class="ti ti-x me-1"></i> Rədd et
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center p-5 bg-light rounded-3 mt-3">
                            <i class="ti ti-mail-off fs-1 text-muted"></i>
                            <h4 class="mt-3">Gözləyən Dəvət Yoxdur</h4>
                            <p class="text-muted">Hal-hazırda cavabınızı gözləyən yeni dəvətiniz yoxdur.</p>
                        </div>
                    }
                </div>

                <!-- Accepted Invitations Pane -->
                <div class="tab-pane fade p-3" id="accepted-tab-pane" role="tabpanel" aria-labelledby="accepted-tab" tabindex="0">
                    @if (acceptedInvitations.Any())
                    {
                        foreach (var invitation in acceptedInvitations)
                        {
                            <div class="card mb-3 shadow-sm border-start border-5 border-success">
                                <div class="card-body">
                                    <div class="row align-items-center">
                                        <div class="col-md-8">
                                            <h5 class="card-title">@invitation.Event.Description</h5>
                                            <p class="card-text text-muted mb-2">
                                                <i class="ti ti-calendar-event me-1"></i> @invitation.Event.StartDate.ToString("dd MMMM yyyy, HH:mm")
                                            </p>
                                            <p class="card-text text-muted mb-0">
                                                <i class="ti ti-map-pin me-1"></i> @invitation.Event.Location?.Name
                                            </p>
                                        </div>
                                        <div class="col-md-4 text-md-end">
                                            <span class="badge bg-light-success text-success fs-4 fw-semibold">Qəbul Edilib</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center p-5 bg-light rounded-3 mt-3">
                            <i class="ti ti-circle-check fs-1 text-muted"></i>
                            <h4 class="mt-3">Qəbul Edilmiş Dəvət Yoxdur</h4>
                            <p class="text-muted">Siz hələ heç bir dəvəti qəbul etməmisiniz.</p>
                        </div>
                    }
                </div>

                <!-- Declined Invitations Pane -->
                <div class="tab-pane fade p-3" id="declined-tab-pane" role="tabpanel" aria-labelledby="declined-tab" tabindex="0">
                    @if (declinedInvitations.Any())
                    {
                        foreach (var invitation in declinedInvitations)
                        {
                            <div class="card mb-3 shadow-sm border-start border-5 border-danger">
                                <div class="card-body">
                                    <div class="row align-items-center">
                                        <div class="col-md-8">
                                            <h5 class="card-title text-muted">@invitation.Event.Description</h5>
                                        </div>
                                        <div class="col-md-4 text-md-end">
                                            <span class="badge bg-light-danger text-danger fs-4 fw-semibold">Rədd Edilib</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center p-5 bg-light rounded-3 mt-3">
                            <i class="ti ti-circle-x fs-1 text-muted"></i>
                            <h4 class="mt-3">Rədd Edilmiş Dəvət Yoxdur</h4>
                            <p class="text-muted">Sizin tərəfinizdən rədd edilmiş dəvət yoxdur.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
